#!/bin/sh

# Post-installation script for TLinkIOS (rootful and RootHide).

# RootHide bootstrap commands see jbroot as `/` and expose the original iOS
# filesystem through `/rootfs`. Keep user data on rootfs while package-owned
# paths (/Applications, /Library, /usr) remain relative to the bootstrap root.
ROOTFS_PREFIX=""
if [ -d "/rootfs/var/mobile" ]; then
    ROOTFS_PREFIX="/rootfs"
fi
readonly ROOTFS_PREFIX

# Mark script execution
echo "Running WeaponX post-installation script..."
echo "===================================="

# Migrate persistent ProjectX state without removing the legacy copy.
PREFS_DIR="${ROOTFS_PREFIX}/var/mobile/Library/Preferences"
LEGACY_DATA_DIR="${ROOTFS_PREFIX}/var/mobile/Library/ProjectX"
TLINKIOS_DATA_DIR="${ROOTFS_PREFIX}/var/mobile/Library/TLinkIOS"
if [ -d "$LEGACY_DATA_DIR" ] && [ ! -e "$TLINKIOS_DATA_DIR" ]; then
    echo "Migrating ProjectX application data to TLinkIOS..."
    cp -Rp "$LEGACY_DATA_DIR" "$TLINKIOS_DATA_DIR"
fi
mkdir -p "$TLINKIOS_DATA_DIR"
chown -R mobile:mobile "$TLINKIOS_DATA_DIR"

for LEGACY_PREF in "$PREFS_DIR"/com.hydra.projectx*.plist; do
    [ -e "$LEGACY_PREF" ] || continue
    PREF_BASENAME="${LEGACY_PREF##*/}"
    NEW_PREF_BASENAME="$(printf '%s' "$PREF_BASENAME" | sed 's/^com\.hydra\.projectx/com.hydra.tlinkios/')"
    NEW_PREF="$PREFS_DIR/$NEW_PREF_BASENAME"
    if [ ! -e "$NEW_PREF" ]; then
        cp -p "$LEGACY_PREF" "$NEW_PREF"
        chown mobile:mobile "$NEW_PREF"
    fi
done

LEGACY_FILTER="$TLINKIOS_DATA_DIR/filter_plists/ProjectXTweak.plist"
TLINKIOS_FILTER="$TLINKIOS_DATA_DIR/filter_plists/TLinkIOSTweak.plist"
if [ -f "$LEGACY_FILTER" ] && [ ! -e "$TLINKIOS_FILTER" ]; then
    cp -p "$LEGACY_FILTER" "$TLINKIOS_FILTER"
    chown mobile:mobile "$TLINKIOS_FILTER"
fi

rm -f /Library/MobileSubstrate/DynamicLibraries/ProjectXTweak.dylib
rm -f /Library/MobileSubstrate/DynamicLibraries/ProjectXTweak.plist
rm -f /usr/bin/projectx-setup

# Create required directories with proper permissions
echo "📂 Creating required directories..."

# Create WeaponX directory
WEAPONX_MOBILE_DIR="${ROOTFS_PREFIX}/var/mobile/Library/WeaponX"
mkdir -p "$WEAPONX_MOBILE_DIR"
chmod 755 "$WEAPONX_MOBILE_DIR"
chown mobile:mobile "$WEAPONX_MOBILE_DIR"

# Publish packaged databases to the persistent rootfs location used by app and
# injected processes. The package copy remains the immutable fallback.
mkdir -p "$WEAPONX_MOBILE_DIR/Data"
for DB_FILE in /Library/WeaponX/Data/*.json; do
    [ -f "$DB_FILE" ] || continue
    cp -f "$DB_FILE" "$WEAPONX_MOBILE_DIR/Data/"
done
chmod 755 "$WEAPONX_MOBILE_DIR/Data"
chmod 644 "$WEAPONX_MOBILE_DIR/Data/"*.json 2>/dev/null || true
chown -R mobile:mobile "$WEAPONX_MOBILE_DIR/Data"

# Create Log directory for TLinkIOS
MOBILE_LOGS_DIR="${ROOTFS_PREFIX}/var/mobile/Library/Logs"
if [ -d "$MOBILE_LOGS_DIR/ProjectX" ] && [ ! -e "$MOBILE_LOGS_DIR/TLinkIOS" ]; then
    cp -Rp "$MOBILE_LOGS_DIR/ProjectX" "$MOBILE_LOGS_DIR/TLinkIOS"
fi
mkdir -p "$MOBILE_LOGS_DIR/TLinkIOS"
chmod 777 "$MOBILE_LOGS_DIR/TLinkIOS"
chown mobile:mobile "$MOBILE_LOGS_DIR/TLinkIOS"

# Create Sandbox/Profile directory (for LibSandy)
mkdir -p "/Library/Sandbox/Profile"
chmod 755 "/Library/Sandbox/Profile"
chown root:wheel "/Library/Sandbox/Profile"

# Create libSandy directory
mkdir -p "/Library/libSandy"
chmod 755 "/Library/libSandy"
chown root:wheel "/Library/libSandy"

# Define paths for profile file
LIBSANDY_PROFILE="/Library/libSandy/tlinkios_filesystem_access.plist"
MS_PROFILE="/Library/MobileSubstrate/DynamicLibraries/tlinkios_filesystem_access.plist"
SANDBOX_PROFILE="/Library/Sandbox/Profile/tlinkios_filesystem_access.plist"

# Copy profile to libSandy location
if [ -f "$MS_PROFILE" ]; then
    echo "📄 Copying LibSandy profile from MobileSubstrate..."
    cp -f "$MS_PROFILE" "$LIBSANDY_PROFILE"
    chmod 644 "$LIBSANDY_PROFILE"
    chown root:wheel "$LIBSANDY_PROFILE"
    echo "✅ Copied profile to $LIBSANDY_PROFILE"
else
    echo "⚠️ Profile not found at $MS_PROFILE"
fi

# Copy profile to Sandbox/Profile location (instead of symlinking)
echo "📄 Installing LibSandy profile to Sandbox directory..."
if [ -f "$LIBSANDY_PROFILE" ]; then
    cp -f "$LIBSANDY_PROFILE" "$SANDBOX_PROFILE"
    chmod 644 "$SANDBOX_PROFILE"
    chown root:wheel "$SANDBOX_PROFILE"
    echo "✅ Copied profile to $SANDBOX_PROFILE"
else
    echo "⚠️ LibSandy profile not found at $LIBSANDY_PROFILE"
fi

# Create symlink to Sandbox/Profile if copy failed
if [ ! -f "$SANDBOX_PROFILE" ] && [ -f "$MS_PROFILE" ]; then
    echo "🔗 Creating symlink to profile..."
    ln -sf "$MS_PROFILE" "$SANDBOX_PROFILE"
    echo "✅ Created symlink: $MS_PROFILE -> $SANDBOX_PROFILE"
fi

# Ensure logs exist with correct permissions
echo "📝 Setting up log files..."
mkdir -p "/Library/WeaponX/Guardian"
touch "/Library/WeaponX/Guardian/daemon.log"
touch "/Library/WeaponX/Guardian/guardian-stderr.log"
touch "/Library/WeaponX/Guardian/guardian-stdout.log"
chmod 664 "/Library/WeaponX/Guardian/"*.log
chown mobile:mobile "/Library/WeaponX/Guardian/"*.log
chmod 755 "/Library/WeaponX/Guardian"
chown mobile:mobile "/Library/WeaponX/Guardian"

# Set up LaunchDaemon
echo "🚀 Setting up LaunchDaemon..."

if [ -f "/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist" ]; then
    chmod 644 "/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist"
    chown root:wheel "/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist"
    
    # Try to load daemon using launchctl
    if command -v launchctl >/dev/null 2>&1; then
        echo "🚀 Loading daemon using launchctl..."
        # First, unload it if it's already loaded
        launchctl unload "/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist" 2>/dev/null
        launchctl load "/Library/LaunchDaemons/com.hydra.weaponx.guardian.plist"
    fi
else
    echo "⚠️ LaunchDaemon plist not found"
fi

# Run container fix script if available
if [ -f "/usr/bin/tlinkios-fix-containers" ]; then
    echo "🔧 Running container fix script..."
    "/usr/bin/tlinkios-fix-containers"
fi

# CRITICAL: Register app icon and reload MobileSubstrate
echo "🔄 Registering application with SpringBoard..."
if command -v uicache > /dev/null 2>&1; then
    uicache -p /Applications/TLinkIOS.app
    echo "✅ App registered successfully"
else
    echo "⚠️ uicache not found, trying alternative..."
    killall -9 SpringBoard 2>/dev/null || true
fi

echo "✅ WeaponX installation completed!"
exit 0
